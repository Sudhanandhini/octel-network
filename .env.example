# ------------------------------------------------------------------
#  Contact form ("Send Us A Message") email routing
#  Change an address here and the form uses it on the next submission.
# ------------------------------------------------------------------

# Enquiries where the visitor picks "Sales"
SALES_EMAIL=info@octelnetworks.com

# Enquiries where the visitor picks "Support" (Service)
SUPPORT_EMAIL=helpdesk@octelnetworks.com

# ------------------------------------------------------------------
#  Outgoing mail server (SMTP) used to send the emails
#  SMTP_SECURE: tls (port 587), ssl (port 465) or none
#  Leave SMTP_HOST empty to use PHP's built-in mail() instead.
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# Sender shown on the emails (usually the same as SMTP_USER)
MAIL_FROM=
MAIL_FROM_NAME=Octel Networks Website
